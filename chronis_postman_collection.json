{
  "info": {
    "name": "Chronis Mini Privacy-Aware Memory Timeline API",
    "description": "API collection for testing events, privacy controls, and audit logs in Chronis.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": [""]
        }
      }
    },
    {
      "name": "Get All Permissions",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/permissions",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["permissions"]
        }
      }
    },
    {
      "name": "Toggle Permission (location = false)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enabled\": false\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:5000/permissions/location",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["permissions", "location"]
        }
      }
    },
    {
      "name": "Toggle Permission (location = true)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"enabled\": true\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:5000/permissions/location",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["permissions", "location"]
        }
      }
    },
    {
      "name": "Get Events (All, Paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/events?page=1&per_page=10",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["events"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "per_page", "value": "10" }
          ]
        }
      }
    },
    {
      "name": "Get Events (Filtered by Type)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/events?type=note&page=1&per_page=5",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["events"],
          "query": [
            { "key": "type", "value": "note" },
            { "key": "page", "value": "1" },
            { "key": "per_page", "value": "5" }
          ]
        }
      }
    },
    {
      "name": "Get Single Event by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/events/1",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["events", "1"]
        }
      }
    },
    {
      "name": "Create Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"note\",\n  \"title\": \"Architectural Decision\",\n  \"content\": \"Enforce privacy filters at the database SQL query level.\"\n}"
        },
        "url": {
          "raw": "http://127.0.0.1:5000/events",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["events"]
        }
      }
    },
    {
      "name": "Delete Event by ID",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/events/1",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["events", "1"]
        }
      }
    },
    {
      "name": "Get Audit Log",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://127.0.0.1:5000/audit-log",
          "protocol": "http",
          "host": ["127", "0", "0", "1"],
          "port": "5000",
          "path": ["audit-log"]
        }
      }
    }
  ]
}
